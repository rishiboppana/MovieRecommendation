# Copy to .env and fill in values

# TMDB API (get free key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# Infrastructure (defaults work with docker-compose)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
MLFLOW_TRACKING_URI=http://localhost:5001
REDIS_HOST=localhost
REDIS_PORT=6379

# Data paths
DATA_DIR=./data
AMAZON_REVIEWS_PATH=./data/amazon/Movies_and_TV.jsonl.gz
MOVIELENS_PATH=./data/movielens/ml-25m

# Model config
ALS_RANK=100
ALS_REG_PARAM=0.1
ALS_MAX_ITER=10
ALS_ALPHA=1.0
TOP_N_RECS=20
